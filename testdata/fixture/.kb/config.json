{
  "kb_dir": "docs/kb",

  "prod_roots": ["app", "web", "infra"],
  "prod_extensions": [".py", ".js", ".sh"],
  "path_extensions": [".py", ".js", ".sh", ".json", ".yaml", ".html"],

  "article_types": {
    "arch": "arch",
    "recipe": "recipe",
    "ref": "ref",
    "policy": "policy"
  },

  "ambiguity_roots": ["app", "web"],
  "exclude_substrings": ["node_modules", "/venv/"],

  "test_rules": {
    "dir_substrings": ["/test/", "/tests/"],
    "path_prefixes": ["tests/"],
    "base_prefixes": ["test_"],
    "base_suffixes": ["_test.py"],
    "path_substrings": [".spec."]
  },

  "source_extensions": [".py", ".js"],

  "adapters": [
    {
      "name": "python",
      "extensions": [".py"],
      "pattern": "(?m)^\\s*(?:from|import)\\s+([a-zA-Z_][\\w.]*)",
      "strategy": "dotted-longest-prefix",
      "root": "",
      "underscore_root": "app",
      "underscore_split": true
    },
    {
      "name": "js",
      "extensions": [".js"],
      "pattern": "from\\s+['\"](\\.[^'\"]+)['\"]",
      "strategy": "relative"
    }
  ],

  "stem_rules": [
    { "suffix": "_test.py" },
    { "prefix": "test_", "ext": ".py" },
    { "pattern": "^(.+)\\.spec\\.(?:js|mjs|ts)$" }
  ],

  "lang_families": { ".py": "py", ".js": "js" },

  "not_repo_paths": {
    "uploads/{userId}/avatar.png": "an object-store key, not a repo file (arch-api)"
  },

  "generated_paths": {
    "app/api/schema.json": "emitted by `make schema`; gitignored"
  },

  "extra_link_kinds": [
    {
      "name": "suites",
      "source": "build/suite_map.txt",
      "pattern": "(?m)^map\\s+\"([^\"]+)\"\\s+\"([^\"]*)\"",
      "split": ",",
      "match": "substring",
      "missing": "Regenerate it with `make suite-map`."
    }
  ]
}
